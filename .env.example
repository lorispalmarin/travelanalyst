# Copiare in .env e compilare. Il file .env è ignorato da git.

# Obbligatoria.
OPENAI_API_KEY=sk-...

# Modello. Quello indicato dalla traccia; disponibile sia su OpenAI sia sul deployment Azure.
OPENAI_MODEL=gpt-5.6-luna

# Endpoint. Vuoto per OpenAI; per l'endpoint Azure della traccia:
# OPENAI_BASE_URL=https://genai-colloqui.openai.azure.com/openai/v1/
OPENAI_BASE_URL=

# gpt-5.6-luna ragiona di default e con il reasoning attivo i tool funzionano solo sulla
# Responses API. Mettere a "false" solo per modelli che non la supportano: in quel caso
# serve anche OPENAI_REASONING_EFFORT=none.
OPENAI_USE_RESPONSES_API=true
# OPENAI_REASONING_EFFORT=none

# Numero massimo di passi (chiamate a tool + risposte) per singola domanda.
ASSISTANT_MAX_STEPS=12
