# Copiare in .env e compilare. Il file .env è ignorato da git.

# Obbligatoria.
OPENAI_API_KEY=sk-...

# Modello. Quello indicato dalla traccia; disponibile sia su OpenAI sia sul deployment Azure.
OPENAI_MODEL=gpt-5.6-luna

# Endpoint. Vuoto per OpenAI; per l'endpoint Azure della traccia:
# OPENAI_BASE_URL=https://genai-colloqui.openai.azure.com/openai/v1/
OPENAI_BASE_URL=

# gpt-5.6-luna ragiona di default e con il reasoning attivo i tool funzionano solo sulla
# Responses API. Mettere a "false" solo per modelli che non la supportano: in quel caso
# serve anche OPENAI_REASONING_EFFORT=none.
OPENAI_USE_RESPONSES_API=true
# OPENAI_REASONING_EFFORT=none

# Numero massimo di passi (chiamate a tool + risposte) per singola domanda.
ASSISTANT_MAX_STEPS=12

# --- Server MCP / fonte -----------------------------------------------------
# Queste variabili arrivano al server MCP, che l'assistente avvia come sottoprocesso.

# Cache persistente dei payload della fonte. Il TTL è la soglia oltre la quale si *tenta* una
# rivalidazione: una entry scaduta non viene mai cancellata, e se la fonte non risponde viene
# servita comunque, dichiarata come copia locale. Default 21600 (6 ore).
# La rivalidazione è condizionale (If-None-Match): se il contenuto non è cambiato la fonte
# risponde 304 e non ritrasmette nulla, quindi superare la soglia costa un round trip, non un
# download.
# VS_CACHE_TTL_SECONDS=21600
# VS_CACHE_PATH=var/cache.sqlite3
# VS_CACHE_ENABLED=true

# L'unica eccezione al TTL unico: sugli avvisi la soglia scende a 15 minuti, perché un'allerta
# servita in ritardo è il peggior guasto possibile. Vedi l'ADR 5 in DECISIONS.md.
# VS_ALERTS_TTL_SECONDS=900

# Rete verso viaggiaresicuri.it.
# VS_TIMEOUT_SECONDS=15
# VS_MAX_ATTEMPTS=3
# VS_MAX_CONNECTIONS=8

# --- Embedding (ricerca sugli approfondimenti) -------------------------------
# Usati da `make ingest` e dal server MCP per vettorizzare le domande. Se non li imposti si
# ricade su OPENAI_API_KEY / OPENAI_BASE_URL, quindi con una chiave sola funziona tutto.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSIONS=
